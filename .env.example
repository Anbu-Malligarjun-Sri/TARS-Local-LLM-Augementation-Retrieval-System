# TARS Chatbot Configuration
# Copy this file to .env and fill in your values

# LLM Provider: "openai", "gemini", "lm_studio", "ollama"
LLM_PROVIDER=lm_studio

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# LM Studio Configuration (Local)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen/qwen3.5-9b

# Ollama Configuration (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# TARS Personality Settings (0.0 to 1.0)
TARS_HUMOR_LEVEL=0.60
TARS_HONESTY_LEVEL=0.90
TARS_DISCRETION_LEVEL=0.95

# Voice Settings
VOICE_ENABLED=true
VOICE_RATE=150
VOICE_VOLUME=0.9

# RAG Settings
RAG_ENABLED=true
CHROMA_PERSIST_DIR=./data/vector_db
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
CHROMA_COLLECTION_NAME=tars_knowledge_nomic_v1_5_cosine

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
MAX_TOKENS=2048

# Logging
LOG_LEVEL=INFO

# Phase 1: generate a random owner token (at least 16 characters).
# Pair the browser with this token; never put it in a VITE_ variable.
OWNER_TOKEN=
# Private data stays local unless explicitly enabled.
ALLOW_CLOUD=false
REQUEST_TIMEOUT=60

# Phase 2 personal memory; originals remain untouched.
MEMORY_BACKEND=sql
# MEMORY_DB_PATH defaults to <repository>/.runtime/memory.sqlite3
# Optional PostgreSQL canonical backend (install requirements-memory.txt):
# MEMORY_DATABASE_URL=postgresql://tars:YOUR_PASSWORD@localhost:5432/tars
# lexical works offline; lm_studio uses the configured embedding model.
MEMORY_EMBEDDINGS=lexical

# Optional LM Studio model-specific reasoning toggle (leave unset for other models).
# LM_STUDIO_REASONING_EFFORT=none

# Cloud coding is separate from chat; each job still requires approval.
CODING_ALLOW_CLOUD=false
# CODING_REPOSITORIES={"tars":"C:/path/to/your/repository"}

# Optional absolute path to a supported native Codex CLI executable.
CODING_CODEX_EXECUTABLE=
# Capture directly stated facts from new owner chat messages.
CAPTURE_CHAT_FACTS=true
